/* WHITE */

QMainWindow,
QDialog {
    border-image: url(assets/background/white.jpg) 0 0 0 0 stretch stretch;
    background-color: #FFFFFF;
}

QWidget {
    background-color: transparent;
    color: #292929;
}

QLabel {
    background: transparent;
    color: #292929;
}

QFrame#card {
    background-color: rgba(255, 255, 255, 0.50);
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 10px;
}

QFrame#card:hover {
    background-color: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(0, 0, 0, 0.13);
}

QTabWidget::pane {
    background: transparent;
    border: none;
    top: -1px;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #999999;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 9px 20px;
    margin-right: 3px;
    font-weight: 500;
}

QTabBar::tab:hover {
    color: #555555;
}

QTabBar::tab:selected {
    color: #171717;
    border-bottom: 2px solid #171717;
}

QScrollArea,
QScrollArea > QWidget,
QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QPushButton {
    background-color: rgba(247, 247, 245, 0.96);
    color: #292929;
    border: 1px solid #EAEAE8;
    border-radius: 7px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #EFEFED;
    color: #171717;
    border: 1px solid #D5D5D1;
}

QPushButton:pressed {
    background-color: #E8E8E5;
    color: #171717;
    border: 1px solid #D0D0CC;
}

QPushButton:disabled {
    background-color: #FAFAF9;
    color: #BDBDB9;
    border: 1px solid #F0F0EE;
}

QPushButton#btn_danger {
    background-color: #FAF5F5;
    color: #995C5C;
    border: 1px solid #EFE2E2;
}

QPushButton#btn_danger:hover {
    background-color: #F5EAEA;
    color: #824444;
    border-color: #E8D5D5;
}

QPushButton#btn_success {
    background-color: #F7F7F5;
    color: #292929;
    border: 1px solid #EAEAE8;
    border-radius: 7px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#btn_success:hover {
    background-color: #EFEFED;
    color: #171717;
    border: 1px solid #D5D5D1;
}

QPushButton#btn_success:pressed {
    background-color: #E8E8E5;
    color: #171717;
    border: 1px solid #D0D0CC;
}

QPushButton#btn_success:disabled {
    background-color: #FAFAF9;
    color: #BDBDB9;
    border: 1px solid #F0F0EE;
}

QPushButton#btn_info {
    background-color: #F5F5F3;
    color: #292929;
    border: 1px solid #E5E5E2;
}

QPushButton#btn_info:hover {
    background-color: #EBEBE8;
    color: #171717;
    border: 1px solid #D5D5D1;
}

QPushButton#btn_theme {
    background-color: transparent;
    color: #888888;
    border: 1px solid #EAEAE8;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
}

QPushButton#btn_theme:hover {
    background-color: #F5F5F3;
    color: #292929;
    border-color: #CCCCCA;
}

QLineEdit,
QComboBox {
    background-color: rgba(250, 250, 249, 0.96);
    color: #292929;
    border: 1px solid #E8E8E6;
    border-radius: 7px;
    padding: 7px 12px;
    selection-background-color: #DCDCD9;
    selection-color: #171717;
}

QLineEdit:hover,
QComboBox:hover {
    background-color: #FFFFFF;
    color: #292929;
    border: 1px solid #D5D5D1;
}

QLineEdit:focus,
QComboBox:focus {
    background-color: #FFFFFF;
    color: #292929;
    border: 1px solid #A5A5A0;
}

QLineEdit:disabled,
QComboBox:disabled {
    background-color: #FAFAF9;
    color: #BDBDB9;
    border: 1px solid #F0F0EE;
}

QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #292929;
    border: 1px solid #E8E8E6;
    border-radius: 7px;
    selection-background-color: #F0F0EE;
    selection-color: #171717;
    outline: none;
}

QProgressBar {
    background-color: #EEEEEC;
    border: none;
    border-radius: 3px;
    height: 5px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #777777;
    border-radius: 3px;
}

QProgressBar#bar_success::chunk {
    background-color: #777777;
    border-radius: 3px;
}

QLabel#lbl_title {
    font-size: 18px;
    font-weight: 600;
    color: #171717;
    background: transparent;
}

QLabel#lbl_card_nome {
    font-size: 11pt;
    font-weight: 600;
    color: #292929;
    background: transparent;
}

QLabel#lbl_muted {
    color: #777777;
    background: transparent;
    font-size: 11px;
}

QLabel#lbl_status_ok {
    color: #777777;
    background: transparent;
    font-size: 11px;
    font-weight: 600;
}

QLabel#lbl_status_err {
    color: #A36C6C;
    background: transparent;
    font-size: 11px;
    font-weight: 600;
}

QLabel#tag_expansion {
    background-color: #F2F2F0;
    color: #666666;
    border: 1px solid #E5E5E2;
    border-radius: 5px;
    padding: 2px 7px;
    font-weight: 600;
    font-size: 11px;
}

QLabel#tag_kit {
    background-color: #F7F2F2;
    color: #926B6B;
    border: 1px solid #EEE3E3;
    border-radius: 5px;
    padding: 2px 7px;
    font-weight: 600;
    font-size: 11px;
}

QLabel#tag_free {
    background-color: #F5F5F3;
    color: #777777;
    border: 1px solid #EAEAE8;
    border-radius: 5px;
    padding: 2px 7px;
    font-weight: 600;
    font-size: 11px;
}

QLabel#tag_game {
    background-color: #F2F3F5;
    color: #647181;
    border: 1px solid #E2E5E9;
    border-radius: 5px;
    padding: 2px 7px;
    font-weight: 600;
    font-size: 11px;
}

QLabel#tag_stuff {
    background-color: #F6F4F0;
    color: #88795F;
    border: 1px solid #EAE5DA;
    border-radius: 5px;
    padding: 2px 7px;
    font-weight: 600;
    font-size: 11px;
}

QLabel#tag_default {
    background-color: #F5F5F3;
    color: #777777;
    border: 1px solid #EAEAE8;
    border-radius: 5px;
    padding: 2px 7px;
    font-weight: 600;
    font-size: 11px;
}

QScrollBar:vertical {
    background: transparent;
    width: 5px;
    border: none;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #DDDDDA;
    border-radius: 3px;
    min-height: 25px;
}

QScrollBar::handle:vertical:hover {
    background: #BBBBB7;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 5px;
    border: none;
    border-radius: 3px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #DDDDDA;
    border-radius: 3px;
    min-width: 25px;
}

QScrollBar::handle:horizontal:hover {
    background: #BBBBB7;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #EAEAE8;
}

QWidget#splash,
QFrame#splash {
    background-color: rgba(255, 255, 255, 0.96);
    border: 1px solid #EAEAE8;
    border-radius: 14px;
}

QLabel#lbl_splash_img {
    background: transparent;
}

QToolTip {
    background-color: #FFFFFF;
    color: #292929;
    border: 1px solid #E5E5E2;
    border-radius: 5px;
    padding: 5px 8px;
}

QLabel#lbl_prefix_status {
    color: #777777;
    background: transparent;
}

QCheckBox#lbl_muted {
    background: transparent;
    color: #777777;
    spacing: 8px;
    font-size: 11px;
}

QCheckBox#lbl_muted::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #000000;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.50);
}

QCheckBox#lbl_muted::indicator:hover {
    border: 1px solid #000000;
    background-color: rgba(168, 168, 168, 0.76);
}

QCheckBox#lbl_muted::indicator:checked:hover {
    background-color: #E8E8E5;
    border: 1px solid #555555;
}

QCheckBox#lbl_muted:disabled {
    color: #BDBDB9;
}

QCheckBox#lbl_muted::indicator:checked {
    image: url(assets/icons/check_black.png);
}
